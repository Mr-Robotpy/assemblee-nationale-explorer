{
  "name": "assemblee-nationale-explorer",
  "private": true,
  "description": "Front statique : feuille de style Tailwind, ressources tierces hébergées sur le site, tests de navigateur",
  "scripts": {
    "build:css": "tailwindcss -i assets/tailwind.src.css -o assets/app.css --minify",
    "watch:css": "tailwindcss -i assets/tailwind.src.css -o assets/app.css --watch",
    "vendor": "python3 scripts/vendor_assets.py",
    "test:e2e": "node --test tests/e2e/*.test.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "5.0.18",
    "@fortawesome/fontawesome-free": "6.4.0",
    "chart.js": "4.4.1",
    "playwright": "1.63.0",
    "tailwindcss": "3.4.17"
  }
}
